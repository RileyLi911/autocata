{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkpoint_manifest.schema.json",
  "title": "Per-model checkpoint manifest v2",
  "type": "object",
  "required": ["schema_version", "model_key", "source_kind", "verified_at", "files"],
  "properties": {
    "schema_version": { "const": 2 },
    "model_key": { "type": "string", "minLength": 1 },
    "source_kind": { "enum": ["downloaded", "user_provided", "preexisting_verified"] },
    "source_url": { "type": ["string", "null"] },
    "original_source_path": { "type": ["string", "null"] },
    "revision": { "type": ["string", "null"] },
    "license": { "type": ["string", "null"] },
    "verified_at": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^models/[^/\\\\]+/checkpoints/" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "published_checksum": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
