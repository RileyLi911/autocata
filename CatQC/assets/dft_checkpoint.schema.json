{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dft_checkpoint.schema.json",
  "title": "Per-calculation VASP checkpoint v4",
  "type": "object",
  "required": ["schema_version", "run_id", "calculation_id", "system_type", "structure_sha256", "profile_sha256", "status", "attempt_count", "frame_indices", "energy_eV", "electronic_converged", "ionic_converged", "input_manifest_path", "job_status_path", "output_directory", "last_error", "updated_at"],
  "properties": {
    "schema_version": { "const": 4 },
    "run_id": { "type": "string", "minLength": 1 },
    "calculation_id": { "type": "string", "minLength": 1 },
    "system_type": { "enum": ["slab_adsorbate", "clean_slab", "isolated_adsorbate"] },
    "structure_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["pending", "queued", "running", "complete", "failed", "blocked"] },
    "attempt_count": { "type": "integer", "minimum": 0 },
    "frame_indices": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "energy_eV": { "type": ["number", "null"] },
    "electronic_converged": { "type": ["boolean", "null"] },
    "ionic_converged": { "type": ["boolean", "null"] },
    "max_force_eV_per_A": { "type": ["number", "null"] },
    "electronic_steps_final_ionic_step": { "type": ["integer", "null"], "minimum": 0 },
    "output_energy_crosscheck": {
      "type": ["object", "null"],
      "properties": {
        "vasprun_energy_eV": { "type": "number" },
        "outcar_energy_eV": { "type": "number" },
        "oszicar_energy_eV": { "type": "number" },
        "outcar_electronic_converged": { "const": true },
        "outcar_ionic_converged": { "const": true },
        "oszicar_final_ionic_step_record": { "const": true },
        "oszicar_ionic_step_records": { "type": "integer", "minimum": 1 }
      },
      "required": ["vasprun_energy_eV", "outcar_energy_eV", "oszicar_energy_eV", "outcar_electronic_converged", "outcar_ionic_converged", "oszicar_final_ionic_step_record", "oszicar_ionic_step_records"],
      "additionalProperties": false
    },
    "potcar_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "potcar_titel_lines": { "type": "array", "items": { "type": "string" } },
    "failure_class": { "type": ["string", "null"] },
    "diagnostic_path": { "type": ["string", "null"] },
    "recovery_action": { "type": ["string", "null"] },
    "exit_code": { "type": ["integer", "null"] },
    "signal": { "type": ["integer", "string", "null"] },
    "wrapper_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "termination_reason": { "type": ["string", "null"] },
    "termination_source": { "type": ["string", "null"] },
    "external_scheduler_state": { "type": ["string", "null"] },
    "input_manifest_path": { "type": "string", "minLength": 1 },
    "job_status_path": { "type": "string", "minLength": 1 },
    "output_directory": { "type": "string", "minLength": 1 },
    "last_error": { "type": ["string", "null"] },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
