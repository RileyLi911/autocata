{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dft_execution_preflight.schema.json",
  "title": "DFT execution preflight evidence v4",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "execution_profile_sha256", "runtime_probe_sha256", "runtime_probe_path", "stack_policy", "resource_allocation", "validated_at"],
  "properties": {
    "schema_version": { "const": 4 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed"] },
    "execution_profile_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "runtime_probe_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "runtime_probe_path": { "type": "string", "minLength": 1 },
    "stack_policy": { "type": "object" },
    "resource_allocation": { "type": "object" },
    "probe": { "type": "object" },
    "error": { "type": "string" },
    "validated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
