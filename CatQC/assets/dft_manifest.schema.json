{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dft_manifest.schema.json",
  "title": "Immutable VASP DFT calculation manifest v4",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "frame_count", "structure_source", "structure_input", "profile_path", "profile_sha256", "execution_profile_path", "execution_profile_sha256", "calculations", "frame_mapping"],
  "properties": {
    "schema_version": { "const": 4 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "frame_count": { "type": "integer", "minimum": 1 },
    "structure_source": { "type": "string", "minLength": 1 },
    "structure_input": {
      "type": "object",
      "required": ["input_path", "input_mode", "file_type", "ordering_rule", "source_files", "frame_count"],
      "properties": {
        "input_path": { "type": "string", "minLength": 1 },
        "input_mode": { "enum": ["single_file", "directory_sorted_filename"] },
        "file_type": { "enum": ["xyz", "extxyz", "cif", "poscar", "mixed"] },
        "ordering_rule": { "type": "string", "minLength": 1 },
        "frame_count": { "type": "integer", "minimum": 1 },
        "source_files": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["path", "file_type", "sha256", "frame_count"], "properties": { "path": { "type": "string", "minLength": 1 }, "file_type": { "enum": ["xyz", "extxyz", "cif", "poscar"] }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "frame_count": { "type": "integer", "minimum": 1 } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    },
    "profile_path": { "const": "dft/vasp_profile.json" },
    "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "execution_profile_path": { "const": "dft/execution_profile.json" },
    "execution_profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "calculations": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["calculation_id", "system_type", "structure_sha256", "frame_indices", "checkpoint_path"], "properties": { "calculation_id": { "type": "string" }, "system_type": { "enum": ["slab_adsorbate", "clean_slab", "isolated_adsorbate"] }, "structure_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "frame_indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "checkpoint_path": { "type": "string" } }, "additionalProperties": false } },
    "frame_mapping": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["structure_index", "slab_composition", "slab_adsorbate_calculation_id", "clean_slab_calculation_id", "isolated_adsorbate_calculation_id"], "properties": { "structure_index": { "type": "integer", "minimum": 0 }, "slab_composition": { "type": "string", "minLength": 1 }, "slab_adsorbate_calculation_id": { "type": "string" }, "clean_slab_calculation_id": { "type": "string" }, "isolated_adsorbate_calculation_id": { "type": "string" } }, "additionalProperties": false } }
  },
  "additionalProperties": false
}
