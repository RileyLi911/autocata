{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dft_state.schema.json",
  "title": "Mutable VASP DFT branch state v4",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "manifest_sha256", "expected_calculations", "completed_calculations", "failed_calculations", "active_calculations", "valid_frames", "frame_count", "coverage_fraction", "active_jobs", "partial_approval_path", "next_action", "preflight_status", "failure_classes", "resource_allocation", "next_recovery_action", "timeout_policy", "output_monitor_policy", "termination_events", "external_scheduler_limits", "diagnostic_stop_count", "updated_at"],
  "properties": {
    "schema_version": { "const": 4 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["prepared", "running", "blocked", "complete", "partial_approved"] },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "expected_calculations": { "type": "integer", "minimum": 1 },
    "completed_calculations": { "type": "integer", "minimum": 0 },
    "failed_calculations": { "type": "integer", "minimum": 0 },
    "active_calculations": { "type": "integer", "minimum": 0 },
    "valid_frames": { "type": "integer", "minimum": 0 },
    "frame_count": { "type": "integer", "minimum": 1 },
    "coverage_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "active_jobs": { "type": "array", "items": { "type": "object" } },
    "partial_approval_path": { "type": ["string", "null"] },
    "next_action": { "type": ["string", "null"] },
    "preflight_status": { "enum": ["pending", "passed", "failed", "blocked"] },
    "failure_classes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "resource_allocation": { "type": "object" },
    "next_recovery_action": { "type": ["string", "null"] },
    "timeout_policy": { "type": "object" },
    "output_monitor_policy": { "type": "object" },
    "termination_events": { "type": "array", "items": { "type": "object" } },
    "external_scheduler_limits": { "type": "object" },
    "diagnostic_stop_count": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
