{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment_execution.schema.json",
  "title": "Auditable model environment execution record v4",
  "type": "object",
  "required": ["schema_version", "model_key", "toolchain", "environment_path", "commands", "status", "updated_at"],
  "properties": {
    "schema_version": { "const": 4 },
    "model_key": { "type": "string", "minLength": 1 },
    "toolchain": { "enum": ["uv", "conda", "mamba"] },
    "toolchain_executable": { "type": "string", "minLength": 1 },
    "environment_path": { "type": "string", "minLength": 1 },
    "commands": { "type": "array", "items": { "type": "object" } },
    "runtime": { "type": ["object", "null"] },
    "status": { "enum": ["planned", "created", "installed", "validated", "blocked", "failed"] },
    "last_error": { "type": ["string", "null"] },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
