{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame_checkpoint.schema.json",
  "title": "Per-model per-task frame checkpoint v4",
  "type": "object",
  "required": [
    "schema_version", "run_id", "model_key", "task", "frame_artifacts_required", "frame_directory_template", "expected_frame_count",
    "status", "generation", "completed_indices", "failed_indices", "active_indices",
    "retry_counts", "next_index", "result_path", "error_path", "job_status_path",
    "last_result_sha256", "last_validated_at", "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 4 },
    "run_id": { "type": "string", "minLength": 1 },
    "model_key": { "type": "string", "minLength": 1 },
    "task": { "enum": ["single_point", "relaxation"] },
    "frame_artifacts_required": { "const": true },
    "frame_directory_template": { "type": "string", "pattern": "^models/[^/]+/frames/(single_point|relaxation)/<structure_index:08d>$" },
    "expected_frame_count": { "type": ["integer", "null"], "minimum": 1 },
    "status": { "enum": ["not_requested", "not_initialized", "pending", "queued", "running", "complete", "failed", "blocked", "partial_approved"] },
    "generation": { "type": "integer", "minimum": 0 },
    "completed_indices": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "failed_indices": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "active_indices": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "retry_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "next_index": { "type": ["integer", "null"], "minimum": 0 },
    "result_path": { "type": "string", "minLength": 1 },
    "error_path": { "type": "string", "minLength": 1 },
    "job_status_path": { "type": "string", "minLength": 1 },
    "last_result_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "last_validated_at": { "type": ["string", "null"] },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
