{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_usage_plan.schema.json",
  "title": "Frozen official model usage plan v4",
  "type": "object",
  "required": [
    "schema_version",
    "model_key",
    "status",
    "source_guide_paths",
    "source_guide_hashes",
    "official_imports",
    "checkpoint_loading",
    "calculator_factory",
    "device_policy",
    "dtype_policy",
    "energy_units",
    "single_point_protocol",
    "relaxation_protocol",
    "official_smoke_tests",
    "derived_adaptations",
    "plan_sha256",
    "execution_variant",
    "catalysis_assessment_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "model_key": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "frozen"
    },
    "source_guide_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^models/[^/\\]+/resources/official_guides/"
      }
    },
    "source_guide_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "official_imports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checkpoint_loading": {
      "type": "object",
      "required": [
        "source",
        "variant",
        "verification"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "calculator_factory": {
      "type": "object",
      "minProperties": 1,
      "anyOf": [
        {
          "required": [
            "class"
          ]
        },
        {
          "required": [
            "factory"
          ]
        }
      ]
    },
    "device_policy": {
      "type": "object",
      "required": [
        "device"
      ],
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "dtype_policy": {
      "type": "object",
      "required": [
        "dtype"
      ],
      "properties": {
        "dtype": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "energy_units": {
      "type": "object",
      "required": [
        "energy",
        "force"
      ],
      "properties": {
        "energy": {
          "type": "string",
          "minLength": 1
        },
        "force": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "single_point_protocol": {
      "type": "object",
      "required": [
        "entrypoint"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "relaxation_protocol": {
      "type": "object",
      "required": [
        "entrypoint"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "official_smoke_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "derived_adaptations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "change",
          "reason"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 0
    },
    "unresolved_conflicts": {
      "type": "array",
      "maxItems": 0
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_variant": {
      "$ref": "catalysis_selection.schema.json#/$defs/execution_variant"
    },
    "catalysis_assessment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
