{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "official_usage_smoke_test.schema.json",
  "title": "Official model usage smoke-test evidence v4",
  "type": "object",
  "required": [
    "schema_version",
    "model_key",
    "passed",
    "command",
    "python_executable",
    "imports",
    "checkpoint_path",
    "checkpoint_variant",
    "checkpoint_sha256",
    "calculator_class",
    "device",
    "dtype",
    "energy_unit",
    "force_unit",
    "exit_code",
    "stdout_path",
    "stderr_path",
    "started_at",
    "finished_at",
    "guide_paths",
    "guide_sha256",
    "plan_sha256",
    "plan_file_sha256",
    "adaptations",
    "execution_variant",
    "calculator_initializations"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "model_key": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "const": true
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "python_executable": {
      "type": "string",
      "minLength": 1
    },
    "imports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "checkpoint_path": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_variant": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calculator_class": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "string",
      "minLength": 1
    },
    "dtype": {
      "type": "string",
      "minLength": 1
    },
    "energy_unit": {
      "type": "string",
      "minLength": 1
    },
    "force_unit": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "const": 0
    },
    "stdout_path": {
      "type": "string",
      "minLength": 1
    },
    "stderr_path": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "guide_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "guide_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adaptations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "execution_variant": {
      "$ref": "catalysis_selection.schema.json#/$defs/execution_variant"
    },
    "calculator_initializations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component",
          "execution_variant",
          "calculator_class",
          "object_id",
          "inspection_method",
          "inspection",
          "checkpoint_path",
          "checkpoint_sha256"
        ]
      }
    }
  },
  "additionalProperties": true
}
