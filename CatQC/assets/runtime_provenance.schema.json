{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime_provenance.schema.json",
  "title": "Per-model runtime provenance v2",
  "type": "object",
  "required": [
    "schema_version",
    "model_key",
    "passed",
    "configured_python_executable",
    "observed_python_executable",
    "observed_package_versions",
    "task_runs",
    "official_usage"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "model_key": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "const": true
    },
    "configured_python_executable": {
      "type": "string",
      "minLength": 1
    },
    "observed_python_executable": {
      "type": "string",
      "minLength": 1
    },
    "observed_package_versions": {
      "type": "object",
      "minProperties": 1
    },
    "task_runs": {
      "type": "object",
      "properties": {
        "single_point": {
          "$ref": "#/$defs/taskRun"
        },
        "relaxation": {
          "$ref": "#/$defs/taskRun"
        }
      },
      "additionalProperties": false
    },
    "official_usage": {
      "type": "object",
      "required": [
        "guide_paths",
        "guide_sha256",
        "plan_path",
        "plan_sha256",
        "plan_file_sha256",
        "official_smoke_test_passed"
      ],
      "properties": {
        "guide_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "guide_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "plan_path": {
          "type": "string",
          "minLength": 1
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "official_smoke_test_passed": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "taskRun": {
      "type": "object",
      "required": [
        "python_executable",
        "script_path",
        "script_sha256",
        "imports",
        "checkpoint_path",
        "checkpoint_sha256",
        "calculator_class",
        "device",
        "dtype",
        "energy_unit",
        "force_unit",
        "usage_plan_sha256",
        "execution_variant",
        "calculator_initializations"
      ],
      "properties": {
        "python_executable": {
          "type": "string",
          "minLength": 1
        },
        "script_path": {
          "type": "string",
          "minLength": 1
        },
        "script_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "imports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "checkpoint_path": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "calculator_class": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "energy_unit": {
          "type": "string",
          "minLength": 1
        },
        "force_unit": {
          "type": "string",
          "minLength": 1
        },
        "usage_plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "execution_variant": {
          "$ref": "catalysis_selection.schema.json#/$defs/execution_variant"
        },
        "calculator_initializations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "component",
              "execution_variant",
              "calculator_class",
              "object_id",
              "inspection_method",
              "inspection",
              "checkpoint_path",
              "checkpoint_sha256"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
